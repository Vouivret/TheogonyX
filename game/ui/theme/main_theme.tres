[resource]
default_font_size = 14
HudBar/base_type = &"PanelContainer"
HudBar/styles/panel = SubResource("HudBarStyle")
Drawer/base_type = &"PanelContainer"
Drawer/styles/panel = SubResource("DrawerStyle")
Sheet/base_type = &"PanelContainer"
Sheet/styles/panel = SubResource("SheetStyle")
Bubble/base_type = &"PanelContainer"
Bubble/styles/panel = SubResource("BubbleStyle")
TickerLabel/base_type = &"Label"
TickerLabel/colors/font_outline_color = Color(0, 0, 0, 1)
TickerLabel/constants/outline_size = 4
TickerLabel/font_sizes/font_size = 13
ValueMeter/base_type = &"ProgressBar"
ValueMeter/styles/background = SubResource("MeterBackground")
ValueMeter/styles/fill = SubResource("MeterFill")
