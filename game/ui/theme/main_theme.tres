[gd_resource type="Theme" format=3]

; 色は game/data/palette.json のパレットの値（HudBar・Drawer・Bubble・ticker の縁取りは ink、Sheet は night と stone、メーターの塗りは bone）。
; パレットを替えたら、ここも合わせる。

[sub_resource type="StyleBoxFlat" id="HudBarStyle"]
bg_color = Color(0.0824, 0.0706, 0.1098, 0.62)
content_margin_left = 8.0
content_margin_top = 3.0
content_margin_right = 8.0
content_margin_bottom = 3.0

[sub_resource type="StyleBoxFlat" id="DrawerStyle"]
bg_color = Color(0.0824, 0.0706, 0.1098, 0.92)
content_margin_left = 8.0
content_margin_top = 6.0
content_margin_right = 8.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="SheetStyle"]
bg_color = Color(0.1490, 0.1333, 0.2275, 0.97)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.3608, 0.3529, 0.4157, 1.0)
content_margin_left = 8.0
content_margin_top = 6.0
content_margin_right = 8.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="BubbleStyle"]
bg_color = Color(0.0824, 0.0706, 0.1098, 0.88)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
content_margin_left = 6.0
content_margin_top = 3.0
content_margin_right = 6.0
content_margin_bottom = 3.0

[sub_resource type="StyleBoxFlat" id="MeterBackground"]
bg_color = Color(0.0824, 0.0706, 0.1098, 0.55)

[sub_resource type="StyleBoxFlat" id="MeterFill"]
bg_color = Color(0.8471, 0.8235, 0.7686, 1.0)

[resource]
default_font_size = 14
HudBar/base_type = &"PanelContainer"
HudBar/styles/panel = SubResource("HudBarStyle")
Drawer/base_type = &"PanelContainer"
Drawer/styles/panel = SubResource("DrawerStyle")
Sheet/base_type = &"PanelContainer"
Sheet/styles/panel = SubResource("SheetStyle")
Bubble/base_type = &"PanelContainer"
Bubble/styles/panel = SubResource("BubbleStyle")
TickerLabel/base_type = &"Label"
TickerLabel/colors/font_outline_color = Color(0.0824, 0.0706, 0.1098, 1.0)
TickerLabel/constants/outline_size = 4
TickerLabel/font_sizes/font_size = 13
ValueMeter/base_type = &"ProgressBar"
ValueMeter/styles/background = SubResource("MeterBackground")
ValueMeter/styles/fill = SubResource("MeterFill")
